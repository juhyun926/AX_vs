# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=sk-your-api-key-here

# 답변 평가 · 질문 생성 · 실시간 코칭에 쓸 모델
OPENAI_MODEL=gpt-4o-mini

# 실제 면접 질문 웹 검색에 쓸 모델 (web_search 도구 지원 모델)
OPENAI_SEARCH_MODEL=gpt-4o-mini

# 음성 인식 모델 (whisper-1 은 '음/어' 같은 습관어를 비교적 잘 받아 적어요)
OPENAI_STT_MODEL=whisper-1

# (배포용) 앱 접속 비밀번호 — 비워두면 잠금 없음
APP_PASSWORD=
